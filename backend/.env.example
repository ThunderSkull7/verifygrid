# VerifyGrid Environment Configuration
# Copy this file to .env and adjust values for your local environment.

APP_NAME=VerifyGrid
APP_VERSION=0.1.0
DEBUG=True

# PostgreSQL connection string using psycopg 3 driver
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/verifygrid

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# Upload storage settings
STORAGE_ROOT=storage/uploads
MAX_UPLOAD_BYTES=26214400

# Authentication & Security
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

